# SmartSurplus Ecosystem Environment Variables Configuration

# 1. Server Configuration
PORT=5000

# 2. Database Configuration (Supabase PostgreSQL Cloud / Local PostgreSQL)
# For Supabase Cloud PostgreSQL:
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_USER=postgres.your_supabase_project_id
DB_PASSWORD=your_supabase_database_password
DB_NAME=postgres
DB_PORT=5432
DB_SSL=true
SUPABASE_PROJECT_ID=your_supabase_project_id

# Optional: Local Database Reference (for migration scripts)
LOCAL_DB_HOST=localhost
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=your_local_postgres_password
LOCAL_DB_NAME=smart_surplus
LOCAL_DB_PORT=5432

# 3. Authentication JWT Secret Key
JWT_SECRET=smartsurplus_super_secret_jwt_key_2026

# 4. Email Notification Configuration (Nodemailer / Gmail)
EMAIL_USER=demo.smartsurplus@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# 5. SMS Gateway Notification Configuration
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=SMARTSURPLUS
SMS_MODE=mock

# 6. Sponsor Payment Integration Configuration (Stitch)
PAYMENT_MODE=mock
STITCH_API_KEY=your_stitch_api_key
STITCH_SECRET=your_stitch_secret_key
STITCH_BASE_URL=https://api.stitch.money
