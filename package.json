{
  "name": "smartsurplus-root",
  "private": true,
  "version": "1.0.0",
  "description": "SmartSurplus Ecosystem Root Package",
  "scripts": {
    "dev": "node scripts/start-all.js",
    "start": "node backend/server.js",
    "build": "npm --prefix backend install --include=dev && npm --prefix frontend install --include=dev && npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "db:init": "npm --prefix backend run db:init",
    "db:clean": "node backend/database/clearFakeData.js",
    "test": "npm --prefix backend test"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x"
  }
}
